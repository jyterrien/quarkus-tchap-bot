<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>fr.gouv.tchap</groupId>
    <artifactId>tchap-bot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Tchap Bot - Parent</name>
    <description>Extension Quarkus pour le développement de bots Tchap/Matrix</description>

    <properties>
        <!-- <maven.install.skip>true</maven.install.skip> -->
        <!-- <maven.deploy.skip>true</maven.deploy.skip> -->

        <argLine></argLine>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.version>3.20.0</quarkus.version>
        <jackson.version>2.17.2</jackson.version>
        <vertx.version>4.5.10</vertx.version>
        <junit.version>5.10.2</junit.version>
        <!-- >= 5.20 / Byte Buddy >= 1.17.7 : requis pour que le mock-maker inline lise les classes Java 25 -->
        <mockito.version>5.20.0</mockito.version>
        <byte-buddy.version>1.17.7</byte-buddy.version>
    </properties>

    <modules>
        <module>matrix-transport-api</module>
        <module>matrix-client-api</module>
        <module>matrix-client-core</module>
        <module>matrix-transport-http</module>
        <module>quarkus-tchap-bot-parent</module>
        <module>quarkus-tchap-bot-integration-tests</module>
        <module>matrix-integration-tests</module>
        <module>examples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Déclarées AVANT le BOM Quarkus : une entrée directe l'emporte sur un BOM importé,
                 qui sinon imposerait ses propres versions (Byte Buddy trop ancien pour Java 25). -->
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${byte-buddy.version}</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>${byte-buddy.version}</version>
            </dependency>

            <!-- BOM Quarkus -->
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Modules internes -->
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>matrix-client-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>matrix-transport-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>matrix-client-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>matrix-transport-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>quarkus-tchap-bot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>quarkus-tchap-bot-deployment</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
