<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>fr.gouv.tchap</groupId>
    <artifactId>quarkus-tchap-bot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Quarkus Tchap Bot Extension - Parent</name>
    <description>Extension Quarkus pour le développement de bots Tchap/Matrix</description>

    <properties>
<!--         <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
 -->
        <argLine></argLine>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.version>3.20.0</quarkus.version>
        <jackson.version>2.17.2</jackson.version>
        <vertx.version>4.5.10</vertx.version>
        <junit.version>5.10.2</junit.version>
        <mockito.version>5.11.0</mockito.version>
    </properties>

    <modules>
        <module>matrix-transport-api</module>
        <module>matrix-client-api</module>
        <module>matrix-client-core</module>
        <module>matrix-transport-http</module>
        <module>quarkus-tchap-bot</module>
        <module>quarkus-tchap-bot-integration-tests</module>
        <module>integration-tests</module>
        <module>examples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- BOM Quarkus -->
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Modules internes -->
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>matrix-client-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>matrix-transport-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>matrix-client-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>matrix-transport-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>quarkus-tchap-bot-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>fr.gouv.tchap</groupId>
                <artifactId>quarkus-tchap-bot-deployment</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
